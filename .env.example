# Optional overrides for `docker compose up`.  Copy to .env (next to
# docker-compose.yml).  Everything has a working default, so this file is
# not needed for a local run.

# Use MongoDB Atlas instead of the bundled MongoDB container
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# MONGO_DB_NAME=triad_dms

# SECRET_KEY=replace-with-a-long-random-string
# ADMIN_PASSWORD=Password123!
# SEED_DEMO_USERS=true
# ALLOW_UNAUTHENTICATED_TEST_UPLOAD=true
# UNSTRACT_API_KEY=
