# nginx config for the frontend container. The ${...} values are filled in
# when the container starts:
#   PORT            port to listen on (Render sets it; Docker Compose uses 80)
#   BACKEND_URL     where the Flask API is, e.g. http://backend:5000 (Compose)
#                   or https://triad-dms-backend.onrender.com (Render)
#   NGINX_RESOLVER  DNS server(s) used to look up BACKEND_URL (see 15-resolver.envsh)
server {
    listen ${PORT};
    server_name _;
    server_tokens off;   # don't advertise the nginx version

    root /usr/share/nginx/html;
    index index.html;

    # Same limit as the API (50 MB).
    client_max_body_size 50m;

    # Look the backend's address up again every 30 s, in case the host moves it.
    resolver ${NGINX_RESOLVER} valid=30s ipv6=off;

    # Pass every /api request to the Flask backend. The browser only ever
    # talks to this server, so no cross-site (CORS) setup is needed.
    location /api/ {
        include /etc/nginx/snippets/security-headers.conf;

        # Flask sends some of the same safety headers; drop its copies so
        # each header appears only once.
        proxy_hide_header X-Frame-Options;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header Referrer-Policy;

        set $backend_upstream ${BACKEND_URL};
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # OCR on big scans takes time, and a sleeping free server needs time to wake.
        proxy_connect_timeout 75s;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # Built JS/CSS files have a hash in their name, so they can be cached for a year.
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # React handles page routing, so any unknown path gets index.html.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
