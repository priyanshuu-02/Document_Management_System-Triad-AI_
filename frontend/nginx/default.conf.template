# Rendered by the nginx image at start-up (envsubst on ${VARS}).
#   BACKEND_URL  - where the Flask API lives, e.g. http://backend:5000 (Compose)
#                  or https://<backend>.onrender.com (Render)
#   PORT         - port to listen on (Render injects it; Compose uses 80)
server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Uploads are capped at 50 MB by the API as well.
    client_max_body_size 50m;

    # Same-origin API: the browser only ever talks to this server, so no CORS
    # configuration is needed in production.
    # Re-resolve the backend hostname periodically: cloud hosts (Render) can
    # change IPs, and a literal proxy_pass would pin the first lookup forever.
    # NGINX_RESOLVER is taken from /etc/resolv.conf by 15-resolver.envsh.
    resolver ${NGINX_RESOLVER} valid=30s ipv6=off;

    location /api/ {
        set $backend_upstream ${BACKEND_URL};
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        # Host defaults to the upstream's host ($proxy_host), which Render's
        # router requires to reach the right service.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # OCR on large scanned files can take a while; free-tier backends may
        # also need time to wake up.
        proxy_connect_timeout 75s;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # Long-lived caching for fingerprinted build assets.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Single-page app: unknown paths fall back to index.html.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
