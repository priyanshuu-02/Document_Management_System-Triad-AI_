# Copy to backend/.env for running the API outside Docker (python run.py).
PORT=5000
# Required: random string used to sign login tokens
SECRET_KEY=replace-with-a-long-random-string
JWT_EXPIRATION_HOURS=24

# Local MongoDB or an Atlas connection string (mongodb+srv://...)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=triad_dms
# true = fall back to a throwaway in-memory DB if MongoDB is unreachable
ALLOW_IN_MEMORY_DB=false

# Only for running the official anonymous-upload test locally
ALLOW_UNAUTHENTICATED_TEST_UPLOAD=false

# Exact origins allowed for cross-origin calls (the Vite dev server proxies /api,
# so this is rarely needed)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# OCR. On Windows point TESSERACT_CMD at tesseract.exe if it is not on PATH.
TESSERACT_CMD=
OCR_LANGUAGES=eng
OCR_MAX_PAGES=20
# Optional cloud OCR fallback (Unstract LLMWhisperer)
UNSTRACT_API_KEY=

# Seeding (python seed_db.py)
ADMIN_EMAIL=admin@triad.ai
ADMIN_PASSWORD=Password123!
ADMIN_DIVISION=Division A
SEED_DEMO_USERS=true
